PLUGIN_NAME = Dir['*.gemspec'][0].split('.')[0..-2].join('.')

task :require_version do
  unless ENV['VERSION']
    puts "VERSION is required: rake build VERSION=X.Y.Z"
    exit 1
  end
end

# Note: The sh command is built into Rake:
# https://rubydoc.info/gems/rake/FileUtils#sh-instance_method
task :build => [:require_version] do
  _, platform, *_ = RUBY_PLATFORM.split("-")
  if platform == 'mswin32' or platform == 'mingw32'
    puts "Warning: Building gem on Windows will lose file permissions"
  end

  # Describe the rules file format for the tool page, from the Python parser
  # itself, so the page's forms never drift from what the firewall accepts.
  # The committed copy is used if Python is unavailable (a test keeps it current).
  schema_cmd = 'python3 targets/EAGLEGATE/lib/eaglegate_rules_parser.py > public/eaglegate_rules_schema.json.tmp'
  if system(schema_cmd)
    FileUtils.mv('public/eaglegate_rules_schema.json.tmp', 'public/eaglegate_rules_schema.json')
  else
    FileUtils.rm_f('public/eaglegate_rules_schema.json.tmp')
    puts "Warning: could not regenerate public/eaglegate_rules_schema.json; using the committed copy"
  end

  # Build the tool page (src/ -> tools/eaglegate/) if we have a package.json.
  # `openc3.sh cli rake build` runs in a container without Node or pnpm; then
  # package a tool page that was already built (pnpm build, or the openc3-node
  # container), or explain how to build one.
  if File.exist?('package.json')
    if system('pnpm --version > /dev/null 2>&1')
      sh('pnpm run build') do |ok, status|
        raise "pnpm run build failed" if !ok
      end
    elsif File.exist?('tools/eaglegate/main.js')
      puts "Warning: pnpm not found; packaging the tool page already built in tools/eaglegate/"
      puts "         (run `pnpm build` first if you changed anything under src/)"
      # The schema may have just been regenerated; keep the packaged page in step
      FileUtils.cp('public/eaglegate_rules_schema.json', 'tools/eaglegate/eaglegate_rules_schema.json')
    else
      raise <<~MSG
        pnpm not found and the tool page has not been built (no tools/eaglegate/main.js).
        `openc3.sh cli rake build` runs without Node, so build the page first, either:
          - locally:  pnpm install --frozen-lockfile --ignore-scripts && pnpm build
          - or in the openc3-node container (see README.md), which can also run the whole rake build
      MSG
    end
  end

  split_version = ENV['VERSION'].to_s.split('.')
  major = split_version[0]
  minor = split_version[1]
  if ENV['VERSION'] =~ /[a-zA-Z]+/
    # Prerelease version
    remainder = split_version[2..-1].join(".")
    remainder.gsub!('-', '.pre.') # Rubygems replaces dashes with .pre.
    remainder_split = remainder.split('.')
    patch = remainder_split[0]
    other = remainder_split[1..-1].join('.')
    gem_version = "#{major}.#{minor}.#{patch}.#{other}"
  else
    gem_version = ENV['VERSION']
  end
  gem_name = PLUGIN_NAME + '-' + gem_version + '.gem'

  sh('gem', 'build', PLUGIN_NAME)

  # Only a validated gem is left behind, so a .gem file always means "ready to install"
  sh("openc3cli validate #{gem_name}") do |ok, status|
    unless ok
      File.delete(gem_name) if File.exist?(gem_name)
      reason = if status.exitstatus == 127 # command not found
        "openc3cli not found. Build through openc3.sh cli, or install the openc3 gem (gem install openc3)"
      else
        "see the validation errors above"
      end
      abort "BUILD FAILED: #{gem_name} did not validate (#{reason}). The gem was deleted."
    end
  end
  puts "Built and validated #{gem_name}"
end
