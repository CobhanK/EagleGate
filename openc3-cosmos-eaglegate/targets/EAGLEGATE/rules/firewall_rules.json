{
  "version": 1,
  "description": "EAGLEGATE telemetry firewall. Rules are checked top to bottom; the first rule that fires decides. Check rules (authenticity, sequence, rate, range, text) go above the ALLOW rules they protect. Bump 'version' on every change.",
  "default_action": "DENY",
  "rules": [
    {
      "id": "deny-commands-on-tlm-link",
      "description": "Command-type packets never belong on the telemetry downlink",
      "action": "DENY",
      "match": {
        "packet_type": "CMD"
      }
    },
    {
      "id": "example-authenticate-housekeeping",
      "description": "EXAMPLE (disabled): housekeeping must carry a valid MAC; needs the EAGLEGATE_AUTH_KEY secret. The MAC adds mac_bytes to every packet, so raise the sizes in the allow-hk-status / allow-status-3 rules to match before enabling",
      "type": "authenticity",
      "action": "DENY",
      "enabled": false,
      "match": {
        "apid": [
          "0x002",
          "0x003"
        ]
      },
      "params": {
        "key_env": "EAGLEGATE_AUTH_KEY",
        "mac_bytes": 16
      }
    },
    {
      "id": "example-housekeeping-in-sequence",
      "description": "EXAMPLE (disabled): deny replayed or out-of-order housekeeping packets",
      "type": "sequence",
      "action": "DENY",
      "enabled": false,
      "match": {
        "apid": [
          "0x002",
          "0x003"
        ]
      },
      "params": {
        "max_gap": 1
      }
    },
    {
      "id": "example-housekeeping-cadence",
      "description": "EXAMPLE (disabled): housekeeping beacons once per second; deny anything faster",
      "type": "rate",
      "action": "DENY",
      "enabled": false,
      "match": {
        "apid": [
          "0x002",
          "0x003"
        ]
      },
      "params": {
        "min_interval": 0.9
      }
    },
    {
      "id": "example-hk-value-limits",
      "description": "EXAMPLE (disabled): HK_STATUS VALUE (FLOAT32 at byte 6 in cmd_tlm/tlm.txt) must be within its documented limits; replace -100..100 with the real ones",
      "type": "range",
      "action": "DENY",
      "enabled": false,
      "match": {
        "apid": [
          "0x002"
        ]
      },
      "params": {
        "offset": 6,
        "data_type": "FLOAT32",
        "min": -100,
        "max": 100
      }
    },
    {
      "id": "example-text-cfdp-file-names",
      "description": "EXAMPLE (disabled): NOS3 CF_TRANSPACKET file names (STRING items in CF_tlm.txt) may only be plain paths, no '..'. Only useful where CFDP telemetry passes through this firewall",
      "type": "text",
      "action": "DENY",
      "enabled": false,
      "match": {
        "apid": [
          "0x0B1"
        ]
      },
      "params": {
        "fields": [
          {
            "name": "ENG_SRCFILE",
            "offset": 80,
            "length": 64
          },
          {
            "name": "ENG_DSTFILE",
            "offset": 144,
            "length": 64
          },
          {
            "name": "ENG_TMPFILE",
            "offset": 208,
            "length": 64
          },
          {
            "name": "APP_SRCFILE",
            "offset": 320,
            "length": 64
          },
          {
            "name": "APP_DSTFILE",
            "offset": 384,
            "length": 64
          }
        ],
        "encoding": "ascii",
        "profile": "path",
        "deny_substrings": [
          ".."
        ],
        "padding": "nul",
        "no_formula_start": true
      }
    },
    {
      "id": "example-text-cfdp-entity-id",
      "description": "EXAMPLE (disabled): NOS3 CF_TRANSPACKET APP_SRCENTITYID is a number like 0.24",
      "type": "text",
      "action": "DENY",
      "enabled": false,
      "match": {
        "apid": [
          "0x0B1"
        ]
      },
      "params": {
        "fields": [
          {
            "name": "APP_SRCENTITYID",
            "offset": 304,
            "length": 16
          }
        ],
        "encoding": "ascii",
        "profile": "numeric",
        "padding": "nul",
        "min_length": 1
      }
    },
    {
      "id": "example-text-status-message",
      "description": "EXAMPLE (disabled): a free-text status message (replace APID, offset and length with a real STRING item) that may reach scripts or CSV exports",
      "type": "text",
      "action": "DENY",
      "enabled": false,
      "match": {
        "apid": [
          5
        ]
      },
      "params": {
        "fields": [
          {
            "name": "STATUS_MSG",
            "offset": 12,
            "length": 64
          }
        ],
        "encoding": "ascii",
        "profile": "safe_text",
        "padding": "nul",
        "no_formula_start": true,
        "max_length": 63
      }
    },
    {
      "id": "allow-hk-status",
      "description": "HK_STATUS (APID 2): exactly 11 bytes, the size defined in cmd_tlm/tlm.txt",
      "action": "ALLOW",
      "match": {
        "apid": [
          "0x002"
        ],
        "min_length": 11,
        "max_length": 11
      }
    },
    {
      "id": "allow-status-3",
      "description": "STATUS_3 (APID 3): exactly 10 bytes, the size defined in cmd_tlm/tlm.txt",
      "action": "ALLOW",
      "match": {
        "apid": [
          "0x003"
        ],
        "min_length": 10,
        "max_length": 10
      }
    },
    {
      "id": "example-science-small-only",
      "description": "EXAMPLE (disabled): allow science APIDs only up to 512 bytes",
      "action": "ALLOW",
      "enabled": false,
      "match": {
        "apid_range": [
          "0x100",
          "0x1FF"
        ],
        "max_length": 512
      }
    },
    {
      "id": "example-deny-flag-bit",
      "description": "EXAMPLE (disabled): deny APID 5 when the top bit of byte 6 is set",
      "action": "DENY",
      "enabled": false,
      "match": {
        "apid": [
          5
        ],
        "bytes": [
          {
            "offset": 6,
            "mask": "0x80",
            "value": "0x80"
          }
        ]
      }
    }
  ]
}
